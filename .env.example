# Secrets come from 1Password (vault "apso-site"), not from this file. See deploy/secrets.env and
# the "Secrets" section of README.md. This file lists every variable the site reads.

# Resend (contact form fallback email)
RESEND_API_KEY=

# PostHog (analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-PKH9XPPX

# Google Analytics 4 (direct tag)
# Leave unset if GA4 is configured as a tag inside the GTM container,
# otherwise pageviews double-count
NEXT_PUBLIC_GA_ID=

# Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID=

# GoHighLevel (contact form). Private Integration token for the Apso sub-account
# (contacts and notes write scopes), plus that sub-account's location ID.
GHL_API_TOKEN=
GHL_LOCATION_ID=

# Contact form fallback recipient when GoHighLevel fails (defaults to matt@apso.ai)
CONTACT_TO_EMAIL=
