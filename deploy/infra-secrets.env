# 1Password references for infra/ (Pulumi), on top of deploy/secrets.env. Kept separate so a missing
# item here does not break `scripts/with-secrets.sh npm run dev`. Use with SECRETS_ENV (see infra/README.md).
# Token scoped to: Zone (apso.ai) DNS/Zone/Workers Routes/Rulesets edit; Account Workers Scripts edit, Access edit.
CLOUDFLARE_API_TOKEN=op://apso-site/cloudflare-api-token/credential
# Google OAuth client for Cloudflare Access sign-in on preview URLs.
ACCESS_GOOGLE_CLIENT_ID=op://apso-site/cloudflare-access-google/client_id
ACCESS_GOOGLE_CLIENT_SECRET=op://apso-site/cloudflare-access-google/client_secret
# Encrypts secret values in Pulumi state (file or S3 backend).
PULUMI_CONFIG_PASSPHRASE=op://apso-site/pulumi-state/passphrase
